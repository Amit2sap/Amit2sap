# Copy to .env for local runs. On Render, set these under the service's "Environment" tab.
# Never commit real values.

# ---------- WhatsApp Cloud API (Meta) ----------
# Any long random string you invent. Paste the same value into Meta's webhook "Verify token".
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string
# Meta app > App settings > Basic > App secret. Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Permanent System User access token (Business settings > System users > Generate token).
WHATSAPP_ACCESS_TOKEN=
# WhatsApp > API Setup > "Phone number ID" for +91 8100447884 (NOT the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version used for sending.
WHATSAPP_API_VERSION=v21.0
# Owner's personal WhatsApp number, with country code. Gets alerts and can send /pause, /resume.
OWNER_WHATSAPP_NUMBER=91XXXXXXXXXX
# Optional: name of an approved utility template with 2 body variables ({{1}} customer, {{2}} summary).
# If set, owner alerts use it, so they arrive even when the owner hasn't messaged the bot in 24h.
OWNER_ALERT_TEMPLATE=
OWNER_ALERT_TEMPLATE_LANG=en
# Country code added to 10-digit numbers typed in /pause and /resume.
DEFAULT_COUNTRY_CODE=91

# ---------- Shopify ----------
SHOPIFY_STORE_DOMAIN=605e40-ba.myshopify.com
# Custom app Admin API access token (starts with shpat_). Scopes: read_products, read_orders, read_customers.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2025-01
# Public store address used in product links.
STOREFRONT_BASE_URL=https://grasscrafts.com

# ---------- Anthropic (Claude) ----------
ANTHROPIC_API_KEY=
# Model used for replies.
ANTHROPIC_MODEL=claude-sonnet-5-5
# How hard the model thinks: low (fast, cheap, good for chat) | medium | high.
ANTHROPIC_EFFORT=low
# Upper limit on tokens per model call (includes thinking).
ANTHROPIC_MAX_TOKENS=8000
# Server-side refusal fallback (Claude API only). Set false if you switch to a model that rejects it.
ANTHROPIC_REFUSAL_FALLBACK=true
# Max tool calls rounds per customer message.
MAX_TOOL_ITERATIONS=6

# ---------- Behaviour ----------
# true = bot stays silent for everyone (owner commands still work).
PAUSED=false
# Max customer messages per hour before the bot stops replying to that customer.
RATE_LIMIT_PER_HOUR=20
# Conversation memory: last N turns, forgotten after N hours.
HISTORY_TURNS=20
HISTORY_TTL_HOURS=24
# SQLite file. Use a persistent disk path in production if you have one (e.g. /var/data/agent.db).
DATABASE_PATH=./data/agent.db
# Store facts file loaded into the bot's instructions (reloaded automatically when it changes).
STORE_FACTS_PATH=./store_facts.md
# INFO logs never include message text. DEBUG does (use only for troubleshooting).
LOG_LEVEL=INFO

# ---------- Optional: e-mail copies of escalations ----------
# Leave SMTP_HOST empty to disable. Gmail: smtp.gmail.com, port 587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
# true for port 465 (SSL); false for 587 (STARTTLS).
SMTP_USE_SSL=false

# =====================================================================
# AUTOMATIONS (see README "Automations"). Everything that messages a
# customer first is OFF until you switch it on.
# =====================================================================

# WhatsApp Business Account ID (WhatsApp > API Setup). Needed for `python -m app.templates_sync`.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Language of the templates the bot sends: en or hi (both are in templates/whatsapp_templates.json).
TEMPLATE_LANG=en

# ---------- 1. Bulk / corporate lead capture (in-chat, on by default) ----------
LEAD_CAPTURE_ENABLED=true
# Public https link to your corporate catalogue PDF (e.g. a Shopify Files URL). Empty = bot won't offer it.
CATALOGUE_PDF_URL=
CATALOGUE_FILENAME=GrassCrafts-Corporate-Catalogue.pdf

# ---------- 2. Shopify webhooks and follow-up messages ----------
# Shopify webhook signing secret (Settings > Notifications > Webhooks shows it; for a custom app use its API secret key).
SHOPIFY_WEBHOOK_SECRET=
# UTILITY template "order_confirmation" when an order is placed.
ORDER_CONFIRMATION_ENABLED=false
# UTILITY template "order_shipped" with tracking when you fulfil an order.
SHIPPING_UPDATE_ENABLED=false
# MARKETING template "abandoned_cart": ONE reminder per checkout, this many minutes after the customer stops.
ABANDONED_CART_ENABLED=false
ABANDONED_CART_DELAY_MINUTES=60
# MARKETING template "review_request", this many days after the order is fulfilled.
REVIEW_REQUEST_ENABLED=false
REVIEW_REQUEST_DAYS=7
# Where customers leave a review (e.g. your Google review link). Empty = https://grasscrafts.com
REVIEW_URL=
# How often the background scheduler checks for due messages.
SCHEDULER_INTERVAL_SECONDS=60

# ---------- 3. Opt-in / opt-out ----------
# STOP / UNSUBSCRIBE / "band karo" = no more marketing; START = subscribe again.
OPT_OUT_ENABLED=true
# true = marketing templates only go to people with a recorded opt-in (messaged you, ticked Shopify consent, or sent START).
MARKETING_REQUIRES_OPT_IN=true
# true = order/shipping updates also need a recorded opt-in. false = any customer who gave a phone at checkout.
UTILITY_REQUIRES_OPT_IN=false

# ---------- 4. Broadcasts (python -m app.broadcast) ----------
# Must be true before `--confirm` will send anything.
BROADCAST_ENABLED=false
BROADCAST_RATE_PER_SECOND=5

# ---------- 5. Owner daily digest ----------
DIGEST_ENABLED=false
# Hour of day in India time (0-23) when the digest is sent.
DIGEST_HOUR=9
# whatsapp, email, or both (email needs the SMTP_* settings above).
DIGEST_CHANNELS=whatsapp,email

# ---------- 6. Admin dashboard at /admin ----------
# Dashboard stays switched off until ADMIN_PASSWORD is set. Use a long random password.
ADMIN_USER=admin
ADMIN_PASSWORD=
