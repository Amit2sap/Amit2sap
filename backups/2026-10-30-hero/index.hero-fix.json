    "gc_shop_by_price": {
      "type": "custom-liquid",
      "name": "Shop by Price",
      "settings": {
        "custom_liquid": "<div class=\"gc-price page-width\">\n  <h2 class=\"gc-price__h\">Shop by Price</h2>\n  <div class=\"gc-price__grid\">\n    <a href=\"/collections/all?filter.v.price.lte=999&amp;sort_by=best-selling\" class=\"gc-price__t\"><span>Under</span><strong>₹999</strong><em>Everyday picks &amp; return gifts</em></a>\n    <a href=\"/collections/all?filter.v.price.gte=1000&amp;filter.v.price.lte=2500&amp;sort_by=best-selling\" class=\"gc-price__t\"><span>₹1,000 to</span><strong>₹2,500</strong><em>Gifts &amp; home favourites</em></a>\n    <a href=\"/collections/all?filter.v.price.gte=2500&amp;sort_by=best-selling\" class=\"gc-price__t\"><span>Above</span><strong>₹2,500</strong><em>Statement pieces &amp; hampers</em></a>\n  </div>\n</div>\n<style>\n.gc-price__h{text-align:center;margin:0 0 18px}\n.gc-price__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}\n.gc-price__t{display:flex;flex-direction:column;align-items:center;padding:26px 12px;border-radius:6px;background:#e8dfd5;color:#3e2723;text-decoration:none;transition:transform .2s}\n.gc-price__t:hover{transform:translateY(-3px)}\n.gc-price__t span{font-size:1.3rem;letter-spacing:.06em;text-transform:uppercase}\n.gc-price__t strong{font-size:3rem;line-height:1.2;color:#6b8e4e}\n.gc-price__t em{font-style:normal;font-size:1.3rem;color:#6d5b55;text-align:center}\n@media(max-width:749px){.gc-price__grid{grid-template-columns:1fr}.gc-price__t{padding:16px}}\n</style>",
        "color_scheme": "scheme-1",
        "padding_top": 28,
        "padding_bottom": 28
      }
    },
    "gc_home_faq": {
      "type": "collapsible-content",
      "blocks": {
        "faq_0": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you deliver all over India?",
            "icon": "question_mark",
            "row_content": "<p>Yes, we deliver pan-India. Shipping is free on orders of ₹1,299 and above; orders below ₹1,299 pay a flat ₹120.</p>"
          }
        },
        "faq_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you ship internationally?",
            "icon": "question_mark",
            "row_content": "<p>Yes. We ship to the US, UK, Canada, Australia, Singapore, the UAE and most of Europe at a flat ₹1,700 per order; the exact charge is shown at checkout.</p>"
          }
        },
        "faq_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What is your return policy?",
            "icon": "question_mark",
            "row_content": "<p>You can request a return or report a damaged or incorrect item within 3 days. Please keep the unboxing video and your proof of purchase. See our <a href=\"/policies/refund-policy\">refund policy</a>.</p>"
          }
        },
        "faq_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Do you take bulk and corporate gifting orders?",
            "icon": "question_mark",
            "row_content": "<p>Yes. For corporate gifting, weddings, events or wholesale, use the quote form on our <a href=\"/pages/wholesale-corporate-gifting\">wholesale &amp; corporate gifting page</a> or WhatsApp +91 62907 44782.</p>"
          }
        },
        "faq_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What materials do you use?",
            "icon": "question_mark",
            "row_content": "<p>Natural fibres including Kauna, Sabai, Madurkathi, Sitalpati and Kash grass, plus cane, bamboo, jute and water hyacinth, handwoven by artisans across India. Compare them in our <a href=\"/pages/materials-guide-compare-natural-grasses-fibers\">materials guide</a>.</p>"
          }
        },
        "faq_5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I care for natural grass products?",
            "icon": "question_mark",
            "row_content": "<p>Keep away from prolonged moisture and direct sunlight, wipe with a dry or slightly damp cloth and store in a cool, dry place. Avoid machine washing.</p>"
          }
        }
      },
      "block_order": [
