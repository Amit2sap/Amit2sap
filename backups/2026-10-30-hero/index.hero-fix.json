    "gc_usp_strip": {
      "type": "custom-liquid",
      "name": "Why GrassCrafts",
      "settings": {
        "custom_liquid": "{%- assign gr = shop.metafields.custom.google_reviews.value -%}\n<div class=\"gc-usp page-width\" aria-label=\"Why shop with GrassCrafts\">\n  <div class=\"gc-usp__item\"><span class=\"gc-usp__ic\" aria-hidden=\"true\">&#127807;</span><div><strong>Handwoven in India</strong><span>Made by artisan weavers from natural grasses</span></div></div>\n  <div class=\"gc-usp__item\"><span class=\"gc-usp__ic\" aria-hidden=\"true\">&#128666;</span><div><strong>Free shipping ₹1,299+</strong><span>Flat ₹120 below that, pan-India</span></div></div>\n  <div class=\"gc-usp__item\"><span class=\"gc-usp__ic\" aria-hidden=\"true\">&#8617;</span><div><strong>3-day returns</strong><span>With your unboxing video</span></div></div>\n  {%- if gr and gr.average -%}<div class=\"gc-usp__item\"><span class=\"gc-usp__ic\" aria-hidden=\"true\">&#9733;</span><div><strong>{{ gr.average }}★ on Google</strong><span>From {{ gr.count }} customer reviews</span></div></div>{%- endif -%}\n  <a class=\"gc-usp__item\" href=\"/pages/wholesale-corporate-gifting\"><span class=\"gc-usp__ic\" aria-hidden=\"true\">&#127873;</span><div><strong>Bulk &amp; corporate orders</strong><span>Get a quote from our team</span></div></a>\n</div>\n<style>\n.gc-usp{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;padding-top:6px;padding-bottom:6px}\n.gc-usp__item{display:flex;gap:10px;align-items:flex-start;padding:14px;border:1px solid rgba(62,39,35,.12);border-radius:6px;background:#fff;color:#3e2723;text-decoration:none}\n.gc-usp__item strong{display:block;font-size:1.45rem}.gc-usp__item span{font-size:1.25rem;color:#6d5b55}\n.gc-usp__ic{font-size:2.2rem;line-height:1;color:#6b8e4e}\n@media(max-width:749px){.gc-usp{grid-template-columns:1fr 1fr}.gc-usp__item{padding:10px}}\n</style>",
        "color_scheme": "scheme-1",
        "padding_top": 20,
        "padding_bottom": 12
      }
    },
